+using OscarWatch.Core.Models;
+using Serilog;
+
+namespace OscarWatch.Rotator;
+
+/// <summary>
+/// Drives any Hamlib-supported rotator through a <c>rotctld</c> daemon over TCP.
+/// Start the daemon first, for example <c>rotctld -m &lt;model&gt; -r COM5 -s 9600</c> (<c>rotctl -l</c> lists models), then point
+/// OscarWatch at its host and port (default 4533). See <see cref="HamlibRotctldCodec"/> for the wire format.
+/// </summary>
+public sealed class HamlibRotctldRotator : IRotatorDriver
+{
+    private const int ReplyTimeoutMs = 2000;
+
+    private static readonly ILogger Log = Serilog.Log.ForContext<HamlibRotctldRotator>();
+
+    private readonly IRotatorSerialTransport _port;
+    private readonly SemaphoreSlim _gate = new(1, 1);
+
+    /// <summary>
+    /// Set when rotctld reports that the backend cannot read its position (Hamlib <c>RIG_ENIMPL</c> /
+    /// <c>RIG_ENAVAIL</c>), so later polls skip the query instead of failing every second.
+    /// </summary>
+    private bool _positionUnsupported;
+
+    public HamlibRotctldRotator(string host, int port)
+        : this(new TcpRotatorTransport(host, port, ReplyTimeoutMs, ReplyTimeoutMs, "\n"))
+    {
+    }
+
+    internal HamlibRotctldRotator(IRotatorSerialTransport transport)
+    {
+        _port = transport;
+    }
+
+    public void Open() => _port.Open();
+
+    public void SetPosition(double azimuthDeg, double elevationDeg, RotatorSettings settings)
+    {
+        var az = Math.Clamp(azimuthDeg, 0, settings.MaxAzimuthDeg);
+        var el = Math.Clamp(elevationDeg, 0, settings.MaxElevationDeg);
+        SendCommand(HamlibRotctldCodec.BuildSetPositionCommand(az, el), tolerateUnsupported: false);
+    }
+
+    public void Stop() => SendCommand(HamlibRotctldCodec.StopCommand, tolerateUnsupported: true);
+
+    public (int? Azimuth, int? Elevation) GetPosition()
+    {
+        _gate.Wait();
+        try
+        {
+            if (_positionUnsupported)
+                return (null, null);
+
+            _port.DiscardInBuffer();
+            _port.Write(HamlibRotctldCodec.GetPositionCommand + "\n");
+
+            string first;
+            try
+            {
+                first = _port.ReadLine().Trim();
+            }
+            catch (TimeoutException)
+            {
+                return (null, null);
+            }
+
+            if (HamlibRotctldCodec.TryParseReport(first, out var code))
+            {
+                if (code is HamlibRotctldCodec.ErrorNotImplemented or HamlibRotctldCodec.ErrorNotAvailable)
+                {
+                    _positionUnsupported = true;
+                    Log.Information("rotctld backend cannot report its position (RPRT {Code}); position feedback disabled", code);
+                }
+
+                return (null, null);
+            }
+
+            if (!HamlibRotctldCodec.TryParseAngle(first, out var azimuthDeg))
+                return (null, null);
+
+            int? azimuth = (int)Math.Round(azimuthDeg);
+
+            string second;
+            try
+            {
+                second = _port.ReadLine().Trim();
+            }
+            catch (TimeoutException)
+            {
+                return (azimuth, null);
+            }
+
+            int? elevation = HamlibRotctldCodec.TryParseAngle(second, out var elevationDeg)
+                ? (int)Math.Round(elevationDeg)
+                : null;
+            return (azimuth, elevation);
+        }
+        finally
+        {
+            _gate.Release();
+        }
+    }
+
+    public void Dispose()
+    {
+        try
+        {
+            if (_port.IsOpen)
+            {
+                try { Stop(); } catch { /* ignore */ }
+            }
+        }
+        catch
+        {
+            // ignore dispose errors
+        }
+
+        _port.Dispose();
+        _gate.Dispose();
+    }
+
+    private void SendCommand(string command, bool tolerateUnsupported)
+    {
+        _gate.Wait();
+        try
+        {
+            _port.DiscardInBuffer();
+            _port.Write(command + "\n");
+
+            string reply;
+            try
+            {
+                reply = _port.ReadLine();
+            }
+            catch (TimeoutException)
+            {
+                // Best effort: some backends answer late. The next command discards any stale reply.
+                Log.Debug("rotctld did not answer '{Command}' within {Timeout} ms", command, ReplyTimeoutMs);
+                return;
+            }
+
+            if (!HamlibRotctldCodec.TryParseReport(reply, out var code) || code == 0)
+                return;
+
+            if (tolerateUnsupported
+                && (code is HamlibRotctldCodec.ErrorNotImplemented or HamlibRotctldCodec.ErrorNotAvailable))
+            {
+                Log.Debug("rotctld does not support '{Command}' (RPRT {Code})", command, code);
+                return;
+            }
+
+            throw new InvalidOperationException($"rotctld rejected '{command}' (RPRT {code}).");
+        }
+        finally
+        {
+            _gate.Release();
+        }
+    }
+}
