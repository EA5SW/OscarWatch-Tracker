index 0000000..523d532
--- /dev/null
+++ b/OscarWatch/Rotator/HamlibRotctldCodec.cs
@@ -0,0 +1,61 @@
+using System.Globalization;
+
+namespace OscarWatch.Rotator;
+
+/// <summary>
+/// Hamlib <c>rotctld</c> text protocol (default, non-extended mode), newline terminated.
+/// <list type="bullet">
+/// <item><c>P az el</c> sets the position and is answered with <c>RPRT n</c> (<c>n</c> = 0 on success).</item>
+/// <item><c>p</c> reads the position and is answered with two lines: azimuth, then elevation.</item>
+/// <item><c>S</c> stops the rotator and is answered with <c>RPRT n</c>.</item>
+/// </list>
+/// A failed command of any kind is answered with a negative <c>RPRT</c> code instead of data.
+/// See https://hamlib.github.io/ (rotctld man page).
+/// </summary>
+public static class HamlibRotctldCodec
+{
+    /// <summary>Hamlib <c>RIG_ENIMPL</c>: the backend does not implement the command.</summary>
+    public const int ErrorNotImplemented = -4;
+
+    /// <summary>Hamlib <c>RIG_ENAVAIL</c>: the command is not available on this device.</summary>
+    public const int ErrorNotAvailable = -11;
+
+    public const string GetPositionCommand = "p";
+    public const string StopCommand = "S";
+
+    public static string BuildSetPositionCommand(double azimuthDeg, double elevationDeg) =>
+        $"P {FormatAngle(azimuthDeg)} {FormatAngle(elevationDeg)}";
+
+    /// <summary>True when <paramref name="line"/> is a <c>RPRT n</c> report; <paramref name="code"/> receives <c>n</c>.</summary>
+    public static bool TryParseReport(string? line, out int code)
+    {
+        code = 0;
+        if (string.IsNullOrWhiteSpace(line))
+            return false;
+
+        var text = line.Trim();
+        if (!text.StartsWith("RPRT", StringComparison.OrdinalIgnoreCase))
+            return false;
+
+        return int.TryParse(text.AsSpan(4).Trim(), NumberStyles.Integer, CultureInfo.InvariantCulture, out code);
+    }
+
+    /// <summary>Parses one angle line of a <c>p</c> reply (for example <c>123.450000</c>).</summary>
+    public static bool TryParseAngle(string? line, out double degrees)
+    {
+        degrees = 0;
+        if (string.IsNullOrWhiteSpace(line))
+            return false;
+
+        return double.TryParse(line.Trim(), NumberStyles.Float, CultureInfo.InvariantCulture, out degrees)
+            && !double.IsNaN(degrees)
+            && !double.IsInfinity(degrees);
+    }
+
+    private static string FormatAngle(double degrees)
+    {
+        // Avoid "-0" for negative zero; rotctld accepts plain decimal notation.
+        var value = degrees == 0 ? 0.0 : degrees;
+        return value.ToString("0.##", CultureInfo.InvariantCulture);
+    }
+}
