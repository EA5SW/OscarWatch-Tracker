+using OscarWatch.Core.Models;
+using OscarWatch.Rotator;
+
+namespace OscarWatch.Tests;
+
+public sealed class HamlibRotctldCodecTests
+{
+    [Theory]
+    [InlineData(90.0, 45.0, "P 90 45")]
+    [InlineData(123.456, 45.5, "P 123.46 45.5")]
+    [InlineData(0.0, 0.0, "P 0 0")]
+    [InlineData(-0.0, 10.0, "P 0 10")]
+    [InlineData(450.0, 180.0, "P 450 180")]
+    public void BuildSetPositionCommand_uses_invariant_decimal_notation(double az, double el, string expected)
+    {
+        Assert.Equal(expected, HamlibRotctldCodec.BuildSetPositionCommand(az, el));
+    }
+
+    [Theory]
+    [InlineData("RPRT 0", 0)]
+    [InlineData("RPRT -1", -1)]
+    [InlineData("RPRT -11", -11)]
+    [InlineData("  RPRT -4  ", -4)]
+    public void TryParseReport_reads_the_result_code(string line, int expectedCode)
+    {
+        Assert.True(HamlibRotctldCodec.TryParseReport(line, out var code));
+        Assert.Equal(expectedCode, code);
+    }
+
+    [Theory]
+    [InlineData(null)]
+    [InlineData("")]
+    [InlineData("   ")]
+    [InlineData("123.450000")]
+    [InlineData("RPRT")]
+    [InlineData("RPRT abc")]
+    public void TryParseReport_rejects_anything_that_is_not_a_report(string? line)
+    {
+        Assert.False(HamlibRotctldCodec.TryParseReport(line, out _));
+    }
+
+    [Theory]
+    [InlineData("123.450000", 123.45)]
+    [InlineData("  45  ", 45.0)]
+    [InlineData("-3.5", -3.5)]
+    [InlineData("360.000000\r", 360.0)]
+    public void TryParseAngle_reads_decimal_degrees(string line, double expected)
+    {
+        Assert.True(HamlibRotctldCodec.TryParseAngle(line, out var degrees));
+        Assert.Equal(expected, degrees, 6);
+    }
+
+    [Theory]
+    [InlineData(null)]
+    [InlineData("")]
+    [InlineData("abc")]
+    [InlineData("NaN")]
+    [InlineData("Infinity")]
+    [InlineData("RPRT -1")]
+    public void TryParseAngle_rejects_non_numeric_text(string? line)
+    {
+        Assert.False(HamlibRotctldCodec.TryParseAngle(line, out _));
+    }
+}
+
+public sealed class HamlibRotctldRotatorTests
+{
+    private static readonly RotatorSettings Limits360x90 = new()
+    {
+        AzimuthRange = RotatorAzimuthRange.Deg360,
+        ElevationRange = RotatorElevationRange.Deg90
+    };
+
+    [Fact]
+    public void SetPosition_sends_P_command_and_accepts_RPRT_0()
+    {
+        var transport = new ScriptedRotctldTransport();
+        transport.EnqueueReply("RPRT 0");
+        using var rotator = new HamlibRotctldRotator(transport);
+        rotator.Open();
+
+        rotator.SetPosition(90, 45, new RotatorSettings());
+
+        Assert.Equal("P 90 45\n", transport.Written[0]);
+    }
+
+    [Fact]
+    public void SetPosition_clamps_to_the_configured_ranges()
+    {
+        var transport = new ScriptedRotctldTransport();
+        transport.EnqueueReply("RPRT 0");
+        using var rotator = new HamlibRotctldRotator(transport);
+        rotator.Open();
+
+        rotator.SetPosition(400, 100, Limits360x90);
+
+        Assert.Equal("P 360 90\n", transport.Written[0]);
+    }
+
+    [Fact]
+    public void SetPosition_clamps_negative_values_to_zero()
+    {
+        var transport = new ScriptedRotctldTransport();
+        transport.EnqueueReply("RPRT 0");
+        using var rotator = new HamlibRotctldRotator(transport);
+        rotator.Open();
+
+        rotator.SetPosition(-10, -5, Limits360x90);
+
+        Assert.Equal("P 0 0\n", transport.Written[0]);
+    }
+
+    [Fact]
+    public void SetPosition_throws_when_rotctld_reports_an_error()
+    {
+        var transport = new ScriptedRotctldTransport();
+        transport.EnqueueReply("RPRT -1");
+        using var rotator = new HamlibRotctldRotator(transport);
+        rotator.Open();
+
+        var ex = Assert.Throws<InvalidOperationException>(
+            () => rotator.SetPosition(90, 45, new RotatorSettings()));
+        Assert.Contains("-1", ex.Message);
+    }
+
+    [Fact]
+    public void SetPosition_does_not_throw_when_rotctld_is_slow_to_answer()
+    {
+        var transport = new ScriptedRotctldTransport();
+        using var rotator = new HamlibRotctldRotator(transport);
+        rotator.Open();
+
+        rotator.SetPosition(90, 45, new RotatorSettings());
+
+        Assert.Equal("P 90 45\n", transport.Written[0]);
+    }
+
+    [Fact]
+    public void GetPosition_reads_azimuth_and_elevation_lines()
+    {
+        var transport = new ScriptedRotctldTransport();
+        transport.EnqueueReply("123.450000", "45.600000");
+        using var rotator = new HamlibRotctldRotator(transport);
+        rotator.Open();
+
+        var (azimuth, elevation) = rotator.GetPosition();
+
+        Assert.Equal("p\n", transport.Written[0]);
+        Assert.Equal(123, azimuth);
+        Assert.Equal(46, elevation);
+    }
+
+    [Fact]
+    public void GetPosition_keeps_azimuth_beyond_360_for_overlap_rotators()
+    {
+        var transport = new ScriptedRotctldTransport();
+        transport.EnqueueReply("412.000000", "10.000000");
+        using var rotator = new HamlibRotctldRotator(transport);
+        rotator.Open();
+
+        var (azimuth, elevation) = rotator.GetPosition();
+
+        Assert.Equal(412, azimuth);
+        Assert.Equal(10, elevation);
+    }
+
+    [Fact]
+    public void GetPosition_returns_azimuth_only_when_elevation_line_is_missing()
+    {
+        var transport = new ScriptedRotctldTransport();
+        transport.EnqueueReply("200.000000");
+        using var rotator = new HamlibRotctldRotator(transport);
+        rotator.Open();
+
+        var (azimuth, elevation) = rotator.GetPosition();
+
+        Assert.Equal(200, azimuth);
+        Assert.Null(elevation);
+    }
+
+    [Fact]
+    public void GetPosition_returns_nulls_on_timeout_and_on_garbage()
+    {
+        var transport = new ScriptedRotctldTransport();
+        using var rotator = new HamlibRotctldRotator(transport);
+        rotator.Open();
+
+        Assert.Equal((null, null), rotator.GetPosition());
+
+        transport.EnqueueReply("not a number");
+        Assert.Equal((null, null), rotator.GetPosition());
+    }
+
+    [Fact]
+    public void GetPosition_stops_querying_after_the_backend_reports_it_cannot_read_position()
+    {
+        var transport = new ScriptedRotctldTransport();
+        transport.EnqueueReply("RPRT -11");
+        using var rotator = new HamlibRotctldRotator(transport);
+        rotator.Open();
+
+        Assert.Equal((null, null), rotator.GetPosition());
+        var writesAfterFirstPoll = transport.Written.Count;
+
+        transport.EnqueueReply("100.000000", "20.000000");
+        Assert.Equal((null, null), rotator.GetPosition());
+        Assert.Equal(writesAfterFirstPoll, transport.Written.Count);
+    }
+
+    [Fact]
+    public void GetPosition_keeps_querying_after_a_transient_error()
+    {
+        var transport = new ScriptedRotctldTransport();
+        transport.EnqueueReply("RPRT -5");
+        using var rotator = new HamlibRotctldRotator(transport);
+        rotator.Open();
+
+        Assert.Equal((null, null), rotator.GetPosition());
+
+        transport.EnqueueReply("100.000000", "20.000000");
+        var (azimuth, elevation) = rotator.GetPosition();
+        Assert.Equal(100, azimuth);
+        Assert.Equal(20, elevation);
+    }
+
+    [Fact]
+    public void Stop_sends_S_command()
+    {
+        var transport = new ScriptedRotctldTransport();
+        transport.EnqueueReply("RPRT 0");
+        using var rotator = new HamlibRotctldRotator(transport);
+        rotator.Open();
+
+        rotator.Stop();
+
+        Assert.Equal("S\n", transport.Written[0]);
+    }
+
+    [Theory]
+    [InlineData("RPRT -4")]
+    [InlineData("RPRT -11")]
+    public void Stop_is_tolerated_when_the_backend_does_not_implement_it(string reply)
+    {
+        var transport = new ScriptedRotctldTransport();
+        transport.EnqueueReply(reply);
+        using var rotator = new HamlibRotctldRotator(transport);
+        rotator.Open();
+
+        rotator.Stop();
+
+        Assert.Equal("S\n", transport.Written[0]);
+    }
+
+    [Fact]
+    public void Stop_still_throws_on_other_errors()
+    {
+        var transport = new ScriptedRotctldTransport();
+        transport.EnqueueReply("RPRT -6");
+        using var rotator = new HamlibRotctldRotator(transport);
+        rotator.Open();
+
+        Assert.Throws<InvalidOperationException>(() => rotator.Stop());
+    }
+
+    [Fact]
+    public void Dispose_stops_the_rotator_and_closes_the_transport()
+    {
+        var transport = new ScriptedRotctldTransport();
+        transport.EnqueueReply("RPRT 0");
+        var rotator = new HamlibRotctldRotator(transport);
+        rotator.Open();
+
+        rotator.Dispose();
+
+        Assert.Equal(["S\n"], transport.Written);
+        Assert.False(transport.IsOpen);
+    }
+
+    [Fact]
+    public void Factory_creates_the_rotctld_driver_for_the_hamlib_type()
+    {
+        using var driver = RotatorDriverFactory.Create(new RotatorSettings
+        {
+            Type = RotatorType.HamlibRotctld,
+            NetworkHost = "127.0.0.1",
+            NetworkPort = RotatorSettings.DefaultHamlibRotctldNetworkPort
+        });
+
+        Assert.IsType<HamlibRotctldRotator>(driver);
+    }
+
+    [Fact]
+    public void Settings_treat_hamlib_rotctld_as_a_network_endpoint_even_with_serial_transport()
+    {
+        var settings = new RotatorSettings
+        {
+            Type = RotatorType.HamlibRotctld,
+            TransportKind = RotatorTransportKind.Serial,
+            NetworkHost = "127.0.0.1",
+            NetworkPort = RotatorSettings.DefaultHamlibRotctldNetworkPort,
+            Port = "COM3"
+        };
+
+        Assert.True(settings.UsesNetworkEndpoint);
+        Assert.False(settings.UsesSerialPort);
+        Assert.True(settings.HasConfiguredEndpoint);
+        Assert.Empty(settings.GetConfiguredSerialPorts());
+    }
+
+    [Fact]
+    public void Settings_require_a_host_for_hamlib_rotctld()
+    {
+        var settings = new RotatorSettings
+        {
+            Type = RotatorType.HamlibRotctld,
+            NetworkHost = "",
+            NetworkPort = RotatorSettings.DefaultHamlibRotctldNetworkPort
+        };
+
+        Assert.False(settings.HasConfiguredEndpoint);
+        settings.NetworkHost = "shack-pc";
+        Assert.True(settings.HasConfiguredEndpoint);
+    }
+
+    [Fact]
+    public void Default_port_is_4533()
+    {
+        Assert.Equal(4533, RotatorSettings.DefaultHamlibRotctldNetworkPort);
+    }
+}
+
+/// <summary>Line-oriented transport that replays queued replies and records everything written.</summary>
+internal sealed class ScriptedRotctldTransport : IRotatorSerialTransport
+{
+    private readonly Queue<string> _replies = new();
+
+    public List<string> Written { get; } = [];
+    public bool IsOpen { get; private set; }
+    public bool DtrEnable { get; set; }
+    public bool RtsEnable { get; set; }
+
+    public void EnqueueReply(params string[] lines)
+    {
+        foreach (var line in lines)
+            _replies.Enqueue(line);
+    }
+
+    public void Open() => IsOpen = true;
+
+    public void Write(string text) => Written.Add(text);
+
+    public void Write(byte[] buffer, int offset, int count) =>
+        Written.Add(System.Text.Encoding.ASCII.GetString(buffer, offset, count));
+
+    public void DiscardInBuffer()
+    {
+    }
+
+    public void DiscardOutBuffer()
+    {
+    }
+
+    public string ReadLine() => _replies.Count > 0 ? _replies.Dequeue() : throw new TimeoutException();
+
+    public string ReadExisting() => "";
+
+    public int Read(byte[] buffer, int offset, int count) => 0;
+
+    public void Dispose() => IsOpen = false;
+}
